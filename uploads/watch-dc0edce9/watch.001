:00","text":"# Create 5X5 matrix with values from 1 to 25\r\n\r\narr = np.arange(1,26).reshape(5,5)\r\nprint(arr)\r\n\r\n# \u003e extract last row, , \r\n\r\nprint(arr[4])\r\n\r\n# first column\r\n\r\nprint(arr[:,0])\r\n\r\n# sub matrix containing 3X3\r\n\r\nprint(arr[0:3,0:3])\r\n\r\n\r\n\r\n# Broadcasting parctice\r\n\r\narr = np.random.randint(1,10,(3,1))\r\nprint(arr)\r\n\r\nrra = np.random.randint(1,10,(3,))\r\nprint(rra)\r\n\r\nprint(arr * rra)","author":{"type":"https://schema.org/Person","name":"@kolkatarockerz","url":"https://www.youtube.com/@kolkatarockerz","alternateName":"Anindya Mukherjee"},"upvoteCount":3}]}}},"frameworkUpdates":{"entityBatchUpdate":{"mutations":[{"entityKey":"EgZ0b3BiYXIg9QEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_DELETE","options":{"persistenceOption":"ENTITY_PERSISTENCE_OPTION_INMEMORY_AND_PERSIST"}},{"entityKey":"EgpIRUFUU0VFS0VSIJICKAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"macroMarkersListEntity":{"key":"EgpIRUFUU0VFS0VSIJICKAE%3D","externalVideoId":"uaTigVkG2dk","markersList":{"markerType":"MARKER_TYPE_HEATMAP","markers":[{"startMillis":"0","durationMillis":"46480","intensityScoreNormalized":0.11004686162363608},{"startMillis":"46480","durationMillis":"46480","intensityScoreNormalized":0.051736941997713677},{"startMillis":"92960","durationMillis":"46480","intensityScoreNormalized":0.16773318502640838},{"startMillis":"139440","durationMillis":"46480","intensityScoreNormalized":1},{"startMillis":"185920","durationMillis":"46480","intensityScoreNormalized":0.64739171029989206},{"startMillis":"232400","durationMillis":"46480","intensityScoreNormalized":0.29682178559747535},{"startMillis":"278880","durationMillis":"46480","intensityScoreNormalized":0.18394148521409528},{"startMillis":"325360","durationMillis":"46480","intensityScoreNormalized":0.17841670314240057},{"startMillis":"371840","durationMillis":"46480","intensityScoreNormalized":0.23433679735066323},{"startMillis":"418320","durationMillis":"46480","intensitySc